<article class="customer-card">
  <% if customer.image.attached? %>
    <%= image_tag customer.image,
                  alt: customer.full_name,
                  class: "customer-photo" %>
  <% else %>
    <div class="customer-photo no-photo">No photo</div>
  <% end %>

  <div class="customer-details">
    <h2><%= customer.full_name %></h2>

    <p>
      <strong>Phone:</strong>
      <%= customer.phone_number.presence || "Not provided" %>
    </p>

    <p>
      <strong>Email:</strong>
      <%= customer.email_address.presence || "Not provided" %>
    </p>

    <p>
      <strong>Notes:</strong>
      <%= customer.notes.presence || "No notes" %>
    </p>
  </div>
</article>